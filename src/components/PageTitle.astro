---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { PROJECTS } from '../data/projects';

const id = Astro.locals.starlightRoute.id.replace(/\/$/, '');
const parts = id.split('/').filter(Boolean);
const crumbs: { label: string; href?: string }[] = [{ label: 'Documentation', href: '/wiki/' }];
if (parts[0] === 'wiki') {
	if (parts.length === 1) crumbs[0] = { label: 'Documentation' };
	const project = PROJECTS.find((entry) => entry.slug === parts[1]);
	if (project) {
		crumbs.push({ label: project.name, href: parts.length > 2 ? `/wiki/${project.slug}/` : undefined });
	}
	if (parts.length > 2) {
		crumbs.push({ label: Astro.locals.starlightRoute.entry.data.title });
	}
}
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol>
		{crumbs.map((crumb) => (
			<li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
		))}
	</ol>
</nav>
<Default />
{Astro.locals.starlightRoute.entry.data.description && <p class="page-description">{Astro.locals.starlightRoute.entry.data.description}</p>}

<style>
.page-description { color:var(--sl-color-gray-3); font-size:1.125rem; line-height:1.6; margin-top:.8rem; max-width: 65ch; }
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		margin: 0;
		padding: 0;
		list-style: none;

		font-size: var(--sl-text-sm);
	}
	.crumbs li {
		display: flex;
		align-items: center;
		margin: 0;
	}
	.crumbs li + li::before {
		content: '/';
		margin: 0 0.6rem;


		color: var(--sl-color-gray-4);
	}
	.crumbs a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		font-weight: 500;
	}
	.crumbs a:hover {
		text-decoration: underline;
	}
	.crumbs span {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
</style>
